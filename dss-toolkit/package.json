{
  "name": "dss-toolkit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:backend": "npm run dev --prefix ../backend",
    "dev:all": "concurrently -n frontend,backend -c cyan,magenta \"next dev\" \"npm run dev --prefix ../backend\"",
    "build": "next build",
    "build:all": "npm run build --prefix ../backend && next build",
    "build:static": "STATIC_EXPORT=true NEXT_PUBLIC_BASE_PATH=/digital-security-framework-sl next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "next": "16.2.10",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
